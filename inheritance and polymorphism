interface A {

    void showA();
}

interface B {

    void showB();
}

// Class implementing both interfaces
class C implements A, B {

    public void showA() {

        System.out.println("Interface A");
    }

    public void showB() {

        System.out.println("Interface B");
    }
}

class Main {

    public static void main(String[] args) {

        C obj = new C();

        obj.showA();

        obj.showB();
    }
}


eg:

interface Student {

    void show();
}

// First class
class A implements Student {

    public void show() {

        System.out.println("Engineering Student");
    }
}

// Second class
class B implements Student {

    public void show() {

        System.out.println("Medical Student");
    }
}

class Main {

    public static void main(String[] args) {

        Student s;

        s = new A();
        s.show();

        s = new B();
        s.show();
    }
}
