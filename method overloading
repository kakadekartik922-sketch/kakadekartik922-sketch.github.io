class Main {

    // Power for int
    static int power(int a, int b) {

        int result = 1;

        for (int i = 1; i <= b; i++) {
            result = result * a;
        }

        return result;
    }

    // Power for double
    static double power(double a, int b) {

        double result = 1;

        for (int i = 1; i <= b; i++) {
            result = result * a;
        }

        return result;
    }

    // Absolute for int
    static int absolute(int a) {

        if (a < 0)
            return -a;

        return a;
    }

    // Absolute for double
    static double absolute(double a) {

        if (a < 0)
            return -a;

        return a;
    }

    public static void main(String[] args) {

        System.out.println("Power int = " + power(2, 3));

        System.out.println("Power double = " + power(2.5, 2));

        System.out.println("Absolute int = " + absolute(-10));

        System.out.println("Absolute double = " + absolute(-5.5));
    }
}
